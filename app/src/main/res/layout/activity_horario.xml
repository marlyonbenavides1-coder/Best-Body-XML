<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212">

    <!-- Header - Botón Atrás Circular -->

    <ImageButton
        android:id="@+id/btnBack"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_margin="16dp"
        android:layout_marginStart="4dp"
        android:background="@drawable/bg_circle_border"
        android:contentDescription="Atrás"
        android:padding="10dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_arrow_back"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.061" />

    <TextView
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:text="Calendario de entrenamiento"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@id/btnBack"
        app:layout_constraintStart_toEndOf="@id/btnBack"
        app:layout_constraintTop_toTopOf="@id/btnBack" />

    <!-- Calendario 2026 -->
    <androidx.cardview.widget.CardView
        android:id="@+id/calendarCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="20dp"
        app:cardCornerRadius="15dp"
        app:cardBackgroundColor="#FFFFFF"
        app:layout_constraintTop_toBottomOf="@id/btnBack">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2026"
                    android:textColor="#000000"
                    android:textSize="32sp"
                    android:textStyle="bold"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:text="JUNIO"
                    android:textColor="#8E94A3"
                    android:textSize="24sp"
                    android:textStyle="bold"/>
            </RelativeLayout>

            <!-- Grid de Días -->
            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="7"
                android:alignmentMode="alignBounds">

                <!-- Cabecera Días -->
                <TextView style="@style/CalendarDayHeader" android:text="DOM"/>
                <TextView style="@style/CalendarDayHeader" android:text="LUN"/>
                <TextView style="@style/CalendarDayHeader" android:text="MAR"/>
                <TextView style="@style/CalendarDayHeader" android:text="MIE"/>
                <TextView style="@style/CalendarDayHeader" android:text="JUE"/>
                <TextView style="@style/CalendarDayHeader" android:text="VIE"/>
                <TextView style="@style/CalendarDayHeader" android:text="SAB"/>

                <!-- Fila 1 (Junio 2026 empieza en Lunes) -->
                <TextView style="@style/CalendarDayNumber" android:text=""/>
                <TextView style="@style/CalendarDayNumber" android:text="1"/>
                <TextView style="@style/CalendarDayNumber" android:text="2"/>
                <TextView style="@style/CalendarDayNumber" android:text="3"/>
                <TextView style="@style/CalendarDayNumber" android:text="4"/>
                <TextView style="@style/CalendarDayNumber" android:text="5"/>
                <TextView style="@style/CalendarDayNumber" android:text="6"/>

                <!-- Fila 2 -->
                <TextView style="@style/CalendarDayNumber" android:text="7"/>
                <TextView style="@style/CalendarDayNumber" android:text="8"/>
                <TextView style="@style/CalendarDayNumber" android:text="9"/>
                <TextView style="@style/CalendarDayNumber" android:text="10"/>
                <TextView style="@style/CalendarDayNumber" android:text="11"/>
                <TextView style="@style/CalendarDayNumber" android:text="12"/>
                <TextView style="@style/CalendarDayNumber" android:text="13"/>

                <!-- Fila 3 -->
                <TextView style="@style/CalendarDayNumber" android:text="14"/>
                <TextView style="@style/CalendarDayNumber" android:text="15"/>
                <TextView style="@style/CalendarDayNumber" android:text="16"/>
                <TextView style="@style/CalendarDayNumber" android:text="17"/>
                <TextView style="@style/CalendarDayNumber" android:text="18"/>
                <TextView style="@style/CalendarDayNumber" android:text="19"/>
                <TextView style="@style/CalendarDayNumber" android:text="20"/>

                <!-- Fila 4 (Resaltada como en la imagen) -->
                <TextView style="@style/CalendarDayNumber" android:text="21" android:background="#FCE4E4" android:textColor="#D32F2F"/>
                <TextView style="@style/CalendarDayNumber" android:text="22" android:background="#FCE4E4" android:textColor="#D32F2F"/>
                <TextView style="@style/CalendarDayNumber" android:text="23" android:background="#FCE4E4" android:textColor="#D32F2F"/>
                <TextView style="@style/CalendarDayNumber" android:text="24" android:background="#FCE4E4" android:textColor="#D32F2F"/>
                <TextView style="@style/CalendarDayNumber" android:text="25" android:background="#FCE4E4" android:textColor="#D32F2F"/>
                <TextView style="@style/CalendarDayNumber" android:text="26" android:background="#FCE4E4" android:textColor="#D32F2F"/>
                <TextView style="@style/CalendarDayNumber" android:text="27"/>

                <!-- Fila 5 -->
                <TextView style="@style/CalendarDayNumber" android:text="28"/>
                <TextView style="@style/CalendarDayNumber" android:text="29"/>
                <TextView style="@style/CalendarDayNumber" android:text="30"/>

            </GridLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Lista de Entrenamientos -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        app:layout_constraintTop_toBottomOf="@id/calendarCard">

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="80dp"
            app:cardCornerRadius="10dp"
            app:cardBackgroundColor="#1A1A1A"
            android:layout_marginBottom="12dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <View android:layout_width="4dp" android:layout_height="match_parent" android:background="#E91E1E"/>
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginStart="16dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Entrenamiento de Pecho" android:textColor="#FFFFFF" android:textStyle="bold"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="10:00 AM - 11:30 AM" android:textColor="#88FFFFFF" android:textSize="12sp"/>
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="80dp"
            app:cardCornerRadius="10dp"
            app:cardBackgroundColor="#1A1A1A">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <View android:layout_width="4dp" android:layout_height="match_parent" android:background="#3B4454"/>
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginStart="16dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Entrenamiento de Pierna" android:textColor="#88FFFFFF" android:textStyle="bold"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="04:00 PM - 05:30 PM" android:textColor="#44FFFFFF" android:textSize="12sp"/>
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>

    <!-- Bottom Nav -->
    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:background="#E91E1E"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
            <ImageView android:layout_width="28dp" android:layout_height="28dp" android:src="@drawable/ic_home" android:alpha="0.6" app:tint="#FFFFFF"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="EXPLORAR" android:textColor="#FFFFFF" android:textSize="10sp"/>
        </LinearLayout>

        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
            <ImageView android:layout_width="28dp" android:layout_height="28dp" android:src="@drawable/ic_calendar" app:tint="#FFFFFF"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="HORARIO" android:textColor="#FFFF00" android:textSize="10sp" android:textStyle="bold"/>
        </LinearLayout>

        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
            <ImageView android:layout_width="28dp" android:layout_height="28dp" android:src="@drawable/ic_heart" android:alpha="0.6" app:tint="#FFFFFF"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="FAVORITOS" android:textColor="#FFFFFF" android:textSize="10sp"/>
        </LinearLayout>

        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
            <ImageView android:layout_width="28dp" android:layout_height="28dp" android:src="@drawable/ic_profile" android:alpha="0.6" app:tint="#FFFFFF"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="PERFIL" android:textColor="#FFFFFF" android:textSize="10sp"/>
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>