<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#050A18">

    <!-- Botón Atrás -->
    <ImageButton
        android:id="@+id/btnBack"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="56dp"
        android:background="@drawable/circular_halo_bg"
        android:contentDescription="Atrás"
        android:src="@drawable/ic_arrow_back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Foto de Perfil Central -->
    <ImageView
        android:id="@+id/imageView9"
        android:layout_width="163dp"
        android:layout_height="186dp"
        android:layout_marginTop="72dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/hombre" />

    <!-- Header Stats -->
    <LinearLayout
        android:id="@+id/statsContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:background="@drawable/edit_text_bg"
        android:backgroundTint="#121829"
        android:orientation="horizontal"
        android:padding="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/imageView9">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="12"
                android:textColor="@color/white"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DÍAS"
                android:textColor="#8F94A3"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="5"
                android:textColor="@color/white"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NIVEL"
                android:textColor="#8F94A3"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="850"
                android:textColor="@color/white"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PUNTOS"
                android:textColor="#8F94A3"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@+id/statsContainer"
        app:layout_constraintBottom_toTopOf="@id/bottomNav">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="25dp"
            android:paddingBottom="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CONFIGURACIÓN"
                android:textColor="#8F94A3"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginBottom="15dp" />

            <!-- Notificaciones -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardNotificaciones"
                android:layout_width="match_parent"
                android:layout_height="70dp"
                android:layout_marginBottom="12dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:cardBackgroundColor="#121829"
                app:cardCornerRadius="35dp"
                app:cardElevation="0dp">
                <RelativeLayout android:layout_width="match_parent" android:layout_height="match_parent" android:paddingHorizontal="20dp">
                    <ImageView android:id="@+id/iconNotif" android:layout_width="40dp" android:layout_height="40dp" android:src="@drawable/ic_notifications" android:layout_centerVertical="true" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Notificaciones" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="16sp" android:layout_toEndOf="@id/iconNotif" android:layout_marginStart="15dp" android:layout_centerVertical="true" />
                    <View android:layout_width="10dp" android:layout_height="10dp" android:background="@drawable/ic_circle_bg" android:backgroundTint="#1B65FF" android:layout_centerVertical="true" android:layout_toStartOf="@id/arrow1" android:layout_marginEnd="15dp" />
                    <ImageView android:id="@+id/arrow1" android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_arrow_back" android:rotation="180" android:alpha="0.3" android:layout_alignParentEnd="true" android:layout_centerVertical="true" app:tint="#FFFFFF" />
                </RelativeLayout>
            </androidx.cardview.widget.CardView>

            <!-- Métodos de pago -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardPagos"
                android:layout_width="match_parent"
                android:layout_height="70dp"
                android:layout_marginBottom="12dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:cardBackgroundColor="#121829"
                app:cardCornerRadius="35dp"
                app:cardElevation="0dp">
                <RelativeLayout android:layout_width="match_parent" android:layout_height="match_parent" android:paddingHorizontal="20dp">
                    <ImageView android:id="@+id/iconPagos" android:layout_width="40dp" android:layout_height="40dp" android:src="@drawable/ic_payment" android:layout_centerVertical="true" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Métodos de pago" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="16sp" android:layout_toEndOf="@id/iconPagos" android:layout_marginStart="15dp" android:layout_centerVertical="true" />
                    <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_arrow_back" android:rotation="180" android:alpha="0.3" android:layout_alignParentEnd="true" android:layout_centerVertical="true" app:tint="#FFFFFF" />
                </RelativeLayout>
            </androidx.cardview.widget.CardView>

            <!-- Términos y condiciones -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardTerminos"
                android:layout_width="match_parent"
                android:layout_height="70dp"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="#121829"
                app:cardCornerRadius="35dp"
                app:cardElevation="0dp">
                <RelativeLayout android:layout_width="match_parent" android:layout_height="match_parent" android:paddingHorizontal="20dp">
                    <ImageView android:id="@+id/iconTerminos" android:layout_width="40dp" android:layout_height="40dp" android:src="@drawable/ic_terms" android:layout_centerVertical="true" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Términos y condiciones" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="16sp" android:layout_toEndOf="@id/iconTerminos" android:layout_marginStart="15dp" android:layout_centerVertical="true" />
                    <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_arrow_back" android:rotation="180" android:alpha="0.3" android:layout_alignParentEnd="true" android:layout_centerVertical="true" app:tint="#FFFFFF" />
                </RelativeLayout>
            </androidx.cardview.widget.CardView>

            <!-- Política de Privacidad -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardPrivacidad"
                android:layout_width="match_parent"
                android:layout_height="70dp"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="#121829"
                app:cardCornerRadius="35dp"
                app:cardElevation="0dp">
                <RelativeLayout android:layout_width="match_parent" android:layout_height="match_parent" android:paddingHorizontal="20dp">
                    <ImageView android:id="@+id/iconPriv" android:layout_width="40dp" android:layout_height="40dp" android:src="@drawable/ic_privacy" android:layout_centerVertical="true" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Política de Privacidad" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="16sp" android:layout_toEndOf="@id/iconPriv" android:layout_marginStart="15dp" android:layout_centerVertical="true" />
                    <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_arrow_back" android:rotation="180" android:alpha="0.3" android:layout_alignParentEnd="true" android:layout_centerVertical="true" app:tint="#FFFFFF" />
                </RelativeLayout>
            </androidx.cardview.widget.CardView>

            <!-- Atención al cliente -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardSoporte"
                android:layout_width="match_parent"
                android:layout_height="70dp"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="#121829"
                app:cardCornerRadius="35dp"
                app:cardElevation="0dp">
                <RelativeLayout android:layout_width="match_parent" android:layout_height="match_parent" android:paddingHorizontal="20dp">
                    <ImageView android:id="@+id/iconSupport" android:layout_width="40dp" android:layout_height="40dp" android:src="@drawable/ic_support" android:layout_centerVertical="true" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Atención al cliente" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="16sp" android:layout_toEndOf="@id/iconSupport" android:layout_marginStart="15dp" android:layout_centerVertical="true" />
                    <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_arrow_back" android:rotation="180" android:alpha="0.3" android:layout_alignParentEnd="true" android:layout_centerVertical="true" app:tint="#FFFFFF" />
                </RelativeLayout>
            </androidx.cardview.widget.CardView>

            <!-- Sobre nosotros -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardNosotros"
                android:layout_width="match_parent"
                android:layout_height="70dp"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="#121829"
                app:cardCornerRadius="35dp"
                app:cardElevation="0dp">
                <RelativeLayout android:layout_width="match_parent" android:layout_height="match_parent" android:paddingHorizontal="20dp">
                    <ImageView android:id="@+id/iconAbout" android:layout_width="40dp" android:layout_height="40dp" android:src="@drawable/ic_about" android:layout_centerVertical="true" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Sobre nosotros" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="16sp" android:layout_toEndOf="@id/iconAbout" android:layout_marginStart="15dp" android:layout_centerVertical="true" />
                    <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_arrow_back" android:rotation="180" android:alpha="0.3" android:layout_alignParentEnd="true" android:layout_centerVertical="true" app:tint="#FFFFFF" />
                </RelativeLayout>
            </androidx.cardview.widget.CardView>

            <!-- Botón Cerrar Sesión -->
            <androidx.cardview.widget.CardView
                android:id="@+id/btnLogout"
                android:layout_width="match_parent"
                android:layout_height="70dp"
                android:layout_marginTop="10dp"
                app:cardBackgroundColor="#E91E1E"
                app:cardCornerRadius="35dp"
                app:cardElevation="0dp">
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:orientation="horizontal">
                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_logout"
                        app:tint="#FFFFFF"
                        android:layout_marginEnd="12dp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="CERRAR SESIÓN"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>

    <!-- Barra Inferior Roja -->
    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="85dp"
        android:background="#FF0000"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
            <ImageView android:layout_width="28dp" android:layout_height="28dp" android:src="@drawable/ic_home" android:alpha="0.6" app:tint="#FFFFFF"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="EXPLORAR" android:textColor="#FFFFFF" android:textSize="10sp" android:textStyle="bold"/>
        </LinearLayout>

        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
            <ImageView android:layout_width="28dp" android:layout_height="28dp" android:src="@drawable/ic_calendar" android:alpha="0.6" app:tint="#FFFFFF"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="HORARIO" android:textColor="#FFFFFF" android:textSize="10sp" android:textStyle="bold"/>
        </LinearLayout>

        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
            <ImageView android:layout_width="28dp" android:layout_height="28dp" android:src="@drawable/ic_heart" android:alpha="0.6" app:tint="#FFFFFF"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="FAVORITOS" android:textColor="#FFFFFF" android:textSize="10sp" android:textStyle="bold"/>
        </LinearLayout>

        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
            <ImageView android:layout_width="28dp" android:layout_height="28dp" android:src="@drawable/ic_profile" app:tint="#FFFF00"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="PERFIL" android:textColor="#FFFF00" android:textSize="10sp" android:textStyle="bold"/>
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
